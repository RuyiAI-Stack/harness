{
  "name": "dsh-triton-riscv",
  "version": "0.1.0",
  "description": "DeepSeek Harness bundle for guarded Triton-RISCV operator development and validation",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./native": "./native.js",
    "./config": "./lib/config.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "native.js",
    "lib/native-*.js",
    "lib/tool-policy.js",
    "lib/config.js",
    "lib/prompts.js",
    "prompts/*.md",
    "lib/client.js",
    "cordis.patch.yml",
    "policy.md",
    "python/pyproject.toml",
    "python/LICENSE",
    "python/codex_agent/**/*.py",
    "python/codex_agent/**/*.json",
    "python/codex_agent/**/*.md",
    "python/codex_agent/**/*.yml",
    "python/codex_agent/tests/fixtures/*.sql",
    "python/codex_agent/**/requirements.txt",
    "python/codex_agent/harness/bundle/index.js",
    "python/codex_agent/harness/bundle/native.js",
    "python/codex_agent/harness/bundle/lib/*.js",
    "python/codex_agent/frontend/dist",
    "frontend/src",
    "frontend/public",
    "frontend/index.html",
    "frontend/package.json",
    "frontend/package-lock.json",
    "frontend/tsconfig*.json",
    "frontend/vite.config.ts",
    "scripts",
    "tests",
    "vitest.config.ts",
    "pnpm-lock.yaml",
    "README.md",
    "migration-provenance.json",
    "LICENSE*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "setup": "bash scripts/setup.sh",
    "setup:backend": "bash scripts/setup-backend.sh",
    "workbench": "node scripts/start-workbench.mjs",
    "native:install": "node scripts/native-host.mjs install",
    "native": "node scripts/native-host.mjs web",
    "test:frontend": "npm --prefix frontend test",
    "test:native-host": "node scripts/test-native-host.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:backend": "vitest run --config vitest.config.ts tests/integration/python.spec.ts",
    "prepack": "npm run build && npm test && node scripts/check-package.mjs"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT AND Apache-2.0",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
