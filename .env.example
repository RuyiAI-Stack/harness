# Copy to .env and fill in before launching dsh (or export in the shell).
# This plugin reads these from the process environment; it does not load .env itself.

# ============================================================================
# Global Plugin Settings
# ============================================================================
# [Required] DeepSeek API (required to run the dsh agent)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============================================================================
# dsh-osc Plugin Settings
# ============================================================================
# [Optional] GitHub token for `gh pr create` on the Buckyball repo
GH_TOKEN=

# ============================================================================
# workload-integration Plugin Settings
# ============================================================================
# [Optional] HuggingFace Read token (required for gated/private models)
HF_TOKEN=
